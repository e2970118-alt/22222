# ===========================================
# QuizForge Pro — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit your real .env file to GitHub!

# -------------------------------------------
# DATABASE (PostgreSQL via Supabase)
# -------------------------------------------
# Use the Pooler connection for serverless (Netlify):
DATABASE_URL=postgresql://postgres.XXX:YOUR_PASSWORD@aws-0-XX.pooler.supabase.com:6543/postgres

# -------------------------------------------
# SUPABASE (Cloud auth & real-time)
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------
# GOOGLE GEMINI API (AI brain)
# -------------------------------------------
# Get your API key from: https://aistudio.google.com/apikey
# You can add multiple keys for rate limit failover:
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_API_KEY_2=your-second-key
# GEMINI_API_KEY_3=your-third-key
# GEMINI_API_KEY_4=your-fourth-key
# GEMINI_API_KEY_5=your-fifth-key
# GEMINI_API_KEY_6=your-sixth-key
